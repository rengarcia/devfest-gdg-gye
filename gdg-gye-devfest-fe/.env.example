# Sanity project the site reads its content from (Studio: ../studio-gdg-gye-devfest).
# Both values are public identifiers, not secrets. Copy this file to .env.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=

# Supabase project behind the attendee accounts (../supabase). The publishable key is meant for
# the browser: row-level security protects every table. Never put the secret/service key here.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
