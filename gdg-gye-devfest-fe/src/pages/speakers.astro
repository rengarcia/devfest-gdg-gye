---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PersonCard from '../components/PersonCard.astro';
import RegistroCta from '../components/RegistroCta.astro';
import { getSpeakers, getSpeakersPage } from '../sanity/content';

const [page, speakers] = await Promise.all([getSpeakersPage(), getSpeakers()]);
const { cfp } = page;
---

<BaseLayout title={page.seo.title} description={page.seo.description} family={page.family}>
  <PageHero {...page.hero} />

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="grid grid--3">
        {
          speakers.map((s, i) => (
            <PersonCard
              family={s.family}
              initials={s.initials}
              tag={s.track}
              talk={s.talk}
              name={s.name}
              role={s.role}
              delay={(i % 3) * 80}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div
      class="wrap"
      style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--space-8);align-items:center"
    >
      <div class="reveal" style="display:grid;gap:var(--space-4)">
        <p class="eyebrow">{cfp.eyebrow}</p><h2 class="display display--lg">{cfp.title}</h2><p
          class="lead"
        >
          {cfp.lead}
        </p><div style="display:flex;gap:var(--space-3);flex-wrap:wrap">
          <a class="btn btn--fill" href={cfp.primary.href}>{cfp.primary.label}</a><a
            class="btn"
            href={cfp.secondary.href}>{cfp.secondary.label}</a
          >
        </div>{
          cfp.note && (
            <p class="mono mono--muted" style="font-size:var(--text-mono-sm)">
              {cfp.note}
            </p>
          )
        }
      </div>
      <div class="notch reveal" style="--d:120ms">
        <div class="notch__media">
          {cfp.figure && <img class="notch__img" src={cfp.figure.src} alt={cfp.figure.alt} />}
        </div>{
          cfp.figure?.tag && (
            <span class="chip notch__tag" style="font-size:var(--text-mono-xs)">
              {cfp.figure.tag}
            </span>
          )
        }
      </div>
    </div>
  </section>

  <RegistroCta cta={page.cta} />
</BaseLayout>
