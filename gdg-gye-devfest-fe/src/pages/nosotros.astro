---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import RegistroCta from '../components/RegistroCta.astro';
import PullQuote from '../components/PullQuote.astro';
import { getAboutPage } from '../sanity/content';

const page = await getAboutPage();
const { intro, principles, history, venue } = page;
---

<BaseLayout title={page.seo.title} description={page.seo.description} family={page.family}>
  <PageHero {...page.hero} />

  <section class="section" style="padding-top:0">
    <div
      class="wrap"
      style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--space-8);align-items:center"
    >
      <div class="notch reveal">
        <div class="notch__media">
          {intro.figure && <img class="notch__img" src={intro.figure.src} alt={intro.figure.alt} />}
        </div>{
          intro.figure?.tag && (
            <span class="chip notch__tag" style="font-size:var(--text-mono-xs)">
              {intro.figure.tag}
            </span>
          )
        }
      </div>
      <div class="reveal" style="--d:120ms;display:grid;gap:var(--space-4)">
        <h2 class="display display--md">{intro.title}</h2><p class="lead">{intro.lead}</p><p>
          {intro.body}
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">{principles.eyebrow}</p><h2 class="display display--lg">
          {principles.title}
        </h2>
      </div>
      <div class="grid grid--3" data-stagger>
        {
          principles.items.map((p) => (
            <div class="card reveal" style="display:grid;gap:var(--space-4);align-content:start">
              <>
                <img src={`/assets/glyphs/${p.glyph}.png`} alt="" style="height:40px;width:auto" />
                <h3 class="display display--sm">{p.title}</h3>
                <p>{p.text}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="scallop reveal" style="max-width:900px;margin-inline:auto;text-align:center">
        <PullQuote quote={history.quote} />
      </div>
      <div class="grid grid--3" data-stagger style="margin-top:var(--space-8)">
        {
          history.stats.map((s) => (
            <div class="stat reveal">
              <b class="stat__value" data-count={s.count} data-suffix={s.suffix}>
                {s.count === undefined ? `${s.value}${s.suffix ?? ''}` : 0}
              </b>
              <span class="stat__label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint" style="padding-block:var(--space-9)">
    <div
      class="wrap"
      style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--space-8);align-items:center"
    >
      <div class="reveal" style="display:grid;gap:var(--space-4)">
        <p class="eyebrow">{venue.eyebrow}</p><h2 class="display display--md">
          {venue.title}
        </h2><p class="lead">{venue.lead}</p><a class="btn" href={venue.link.href}
          >{venue.link.label} <Icon name="map" class="btn__icon" /></a
        >
      </div>
      <div
        class="card reveal"
        style="--d:120ms;aspect-ratio:4/3;display:grid;place-items:center;background:var(--gdg-white)"
      >
        <p class="mono mono--muted">{venue.mapNote}</p>
      </div>
    </div>
  </section>

  <RegistroCta cta={page.cta} />
</BaseLayout>
