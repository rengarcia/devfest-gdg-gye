---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SessionRow from '../components/SessionRow.astro';
import RegistroCta from '../components/RegistroCta.astro';
import Dots from '../components/Dots.astro';
import { getSchedule } from '../sanity/content';

const schedule = await getSchedule();
---

<BaseLayout
  title="Agenda"
  description="Agenda de DevFest Guayaquil 2026: tracks Web, Mobile, Cloud y AI."
  family="green"
>
  <PageHero
    eyebrow="Agenda"
    title="Un día, cuatro tracks, 24 sesiones."
    lead="Sábado 5 de diciembre, 08:30 a 18:00. Todas las salas están en el Campus Gustavo Galindo de ESPOL. Puedes moverte entre tracks en cada bloque."
    glyphs={['slash-a', 'hash-green', 'dot-blue']}
  />

  <section class="section" style="padding-top:0">
    <div class="wrap" data-family="green" id="agenda-root">
      <div role="tablist" aria-label="Tracks" class="tabs reveal">
        {
          schedule.map(({ track }, i) => (
            <button
              role="tab"
              class="tabs__tab"
              id={`tab-${track.slug}`}
              aria-controls={`panel-${track.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-family={track.family}
            >
              {track.name}
            </button>
          ))
        }
      </div>
      {
        schedule.map(({ track, sessions }, i) => (
          <div
            role="tabpanel"
            id={`panel-${track.slug}`}
            aria-labelledby={`tab-${track.slug}`}
            hidden={i !== 0}
            style="margin-top:var(--space-6)"
          >
            <div class="card" style="padding-block:var(--space-2)">
              <ul style="list-style:none;margin:0;padding:0">
                {sessions.map((s) => (
                  <SessionRow session={s} />
                ))}
              </ul>
            </div>
          </div>
        ))
      }
      <p
        class="mono mono--muted reveal"
        style="margin-top:var(--space-5);font-size:var(--text-mono-sm)"
      >
        La agenda puede cambiar. Los horarios finales se publican una semana antes del evento.
      </p>
    </div>
  </section>
  <Dots />
  <RegistroCta />
</BaseLayout>
