---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PersonCard from '../components/PersonCard.astro';
import LogoTile from '../components/LogoTile.astro';
import RegistroCta from '../components/RegistroCta.astro';
import Dots from '../components/Dots.astro';
import PullQuote from '../components/PullQuote.astro';
import { getHomePage, getHomeSponsors, getTracks } from '../sanity/content';

const [page, tracks, sponsors] = await Promise.all([getHomePage(), getTracks(), getHomeSponsors()]);
const { hero, stats, speakers } = page;

/** Where the (up to three) floating glyphs sit around the photo, as in the design. */
const glyphSpots = [
  '--d:320ms;position:absolute;right:0;top:0;width:24%',
  '--d:400ms;position:absolute;right:6%;bottom:14%;width:22%',
  '--d:480ms;position:absolute;left:0;bottom:0;width:20%',
];
---

<BaseLayout title={page.seo.title} description={page.seo.description} family={page.family}>
  <section class="section" style="padding-top:var(--space-9);position:relative;overflow:clip">
    <div
      class="wrap"
      style="display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:var(--space-8);align-items:center"
    >
      <div style="display:grid;gap:var(--space-5)">
        <div class="chips sticker">
          {
            hero.chips.map((chip, i) => (
              <span class:list={['chip', { 'chip--tint': i === 0 }]}>{chip}</span>
            ))
          }
        </div>
        <h1 class="display display--xl sticker" style="--d:90ms">{hero.title}</h1>
        <p class="lead sticker" style="--d:180ms">{hero.lead}</p>
        <div class="sticker" style="--d:260ms;display:flex;gap:var(--space-3);flex-wrap:wrap">
          <a class="btn btn--fill" href={hero.primary.href}
            >{hero.primary.label} <Icon name="arrow_forward" class="btn__icon" /></a
          ><a class="btn" href={hero.secondary.href}>{hero.secondary.label}</a>
        </div>
      </div>
      <div style="position:relative;min-height:440px" aria-hidden="true">
        <div class="notch sticker" style="--d:120ms;position:absolute;left:8%;top:6%;width:62%">
          <div class="notch__media">
            {hero.figure && <img class="notch__img" src={hero.figure.src} alt={hero.figure.alt} />}
          </div>{
            hero.figure?.tag && (
              <span class="chip notch__tag" style="font-size:var(--text-mono-xs)">
                {hero.figure.tag}
              </span>
            )
          }
        </div>
        {
          hero.glyphs
            .slice(0, glyphSpots.length)
            .map((g, i) => (
              <img class="float" style={glyphSpots[i]} src={`/assets/glyphs/${g}.png`} alt="" />
            ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint" style="padding-block:var(--space-9)">
    <div class="wrap">
      <div class="grid grid--4" data-stagger>
        {
          stats.map((s) => (
            <div class="stat reveal">
              <b class="stat__value" data-count={s.count} data-suffix={s.suffix}>
                {s.count === undefined ? `${s.value}${s.suffix ?? ''}` : 0}
              </b>
              <span class="stat__label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">{speakers.eyebrow}</p><h2 class="display display--lg">
          {speakers.title}
        </h2><p class="lead">{speakers.lead}</p>
      </div>
      <div class="grid grid--3">
        {
          speakers.featured.map((s, i) => (
            <PersonCard
              family={s.family}
              initials={s.initials}
              tag={s.track}
              talk={s.talk}
              name={s.name}
              role={s.role}
              delay={i * 80}
            />
          ))
        }
      </div>
      <div class="reveal" style="margin-top:var(--space-6)">
        <a class="btn" href={speakers.link.href}
          >{speakers.link.label} <Icon name="arrow_forward" class="btn__icon" /></a
        >
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">{page.tracks.eyebrow}</p><h2 class="display display--lg">
          {page.tracks.title}
        </h2>
      </div>
      <div class="grid grid--4" data-stagger>
        {
          tracks.map((t) => (
            <a
              class="card card--sm hover-lift reveal"
              href="/agenda"
              data-family={t.family}
              style="display:grid;gap:var(--space-4);text-decoration:none;background:var(--tint)"
            >
              <>
                <img src={`/assets/glyphs/${t.glyph}.png`} alt="" style="height:56px;width:auto" />
                <h3 class="display display--sm">{t.name}</h3>
                <p>{t.blurb}</p>
                <span class="chip" style="justify-self:start">
                  {page.tracks.linkLabel}
                </span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="scallop reveal" style="text-align:center;max-width:960px;margin-inline:auto">
        <img
          src="/assets/glyphs/quote-open.png"
          alt=""
          style="height:44px;width:auto;margin:0 auto var(--space-5)"
        />
        <PullQuote quote={page.quote} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">{page.sponsors.eyebrow}</p><h2 class="display display--md">
          {page.sponsors.title}
        </h2>
      </div>
      <div class="grid grid--4" data-stagger>
        {sponsors.map((s) => <LogoTile sponsor={s} href="/sponsors" />)}
      </div>
      <p class="reveal" style="margin-top:var(--space-5)">
        <a href={page.sponsors.link.href}>{page.sponsors.link.label}</a>
      </p>
    </div>
  </section>
  <Dots />
  <RegistroCta cta={page.cta} />
</BaseLayout>
