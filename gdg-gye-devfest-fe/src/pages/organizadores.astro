---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PersonCard from '../components/PersonCard.astro';
import RegistroCta from '../components/RegistroCta.astro';
import { getOrganizers, getOrganizersPage } from '../sanity/content';

const [page, organizers] = await Promise.all([getOrganizersPage(), getOrganizers()]);
const { volunteering } = page;
---

<BaseLayout title={page.seo.title} description={page.seo.description} family={page.family}>
  <PageHero {...page.hero} />

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="grid grid--4">
        {
          organizers.map((o, i) => (
            <PersonCard
              family={o.family}
              initials={o.initials}
              name={o.name}
              role={o.role}
              delay={(i % 3) * 80}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div
      class="wrap"
      style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--space-8);align-items:center"
    >
      <div class="reveal" style="display:grid;gap:var(--space-4)">
        <p class="eyebrow">{volunteering.eyebrow}</p><h2 class="display display--lg">
          {volunteering.title}
        </h2><p class="lead">{volunteering.lead}</p><div
          style="display:flex;gap:var(--space-3);flex-wrap:wrap"
        >
          <a class="btn btn--fill" href={volunteering.primary.href}>{volunteering.primary.label}</a
          ><a class="btn" href={volunteering.secondary.href}>{volunteering.secondary.label}</a>
        </div>
      </div>
      <div class="grid" data-stagger style="grid-template-columns:1fr 1fr">
        {
          /* These figures are shown as written, without the count-up. */
          volunteering.stats.map((s) => (
            <div class="card card--sm stat reveal">
              <>
                <b class="stat__value" style="font-size:var(--text-display-md)">
                  {s.value}
                  {s.suffix}
                </b>
                <span class="stat__label">{s.label}</span>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <RegistroCta cta={page.cta} />
</BaseLayout>
