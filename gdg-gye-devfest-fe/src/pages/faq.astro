---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import RegistroCta from '../components/RegistroCta.astro';
import Dots from '../components/Dots.astro';
import { faqEntities, pageJsonLd } from '../data/jsonld';
import { getFaq, getFaqPage, getSiteSettings } from '../sanity/content';

const [page, faq, settings] = await Promise.all([getFaqPage(), getFaq(), getSiteSettings()]);
const jsonLd = pageJsonLd({
  settings,
  site: Astro.site!,
  path: Astro.url.pathname,
  seo: page.seo,
  type: 'FAQPage',
  extra: faqEntities(faq),
});
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  image={page.seo.image}
  family={page.family}
  {jsonLd}
>
  <PageHero {...page.hero} />

  <section class="section faq" style="padding-top:0">
    <div class="wrap" style="max-width:860px">
      {
        faq.map((item, i) => (
          <details
            class="faq__item reveal"
            style={`--d:${Math.min(i * 50, 250)}ms`}
            id={item.anchor}
          >
            <>
              <summary class="faq__summary">
                <>
                  <span>{item.question}</span>
                  <Icon name="add" class="faq__icon" />
                </>
              </summary>
              <div class="faq__answer">
                <p>{item.answer}</p>
              </div>
            </>
          </details>
        ))
      }
    </div>
  </section>
  <Dots />
  <RegistroCta cta={page.cta} />
</BaseLayout>
