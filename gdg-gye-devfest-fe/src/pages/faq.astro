---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import RegistroCta from '../components/RegistroCta.astro';
import Dots from '../components/Dots.astro';
import { getFaq, getFaqPage } from '../sanity/content';

const [page, faq] = await Promise.all([getFaqPage(), getFaq()]);
---

<BaseLayout title={page.seo.title} description={page.seo.description} family={page.family}>
  <PageHero {...page.hero} />

  <section class="section faq" style="padding-top:0">
    <div class="wrap" style="max-width:860px">
      {
        faq.map((item, i) => (
          <details
            class="faq__item reveal"
            style={`--d:${Math.min(i * 50, 250)}ms`}
            id={item.anchor}
          >
            <>
              <summary class="faq__summary">
                <>
                  <span>{item.question}</span>
                  <Icon name="add" class="faq__icon" />
                </>
              </summary>
              <div class="faq__answer">
                <p>{item.answer}</p>
              </div>
            </>
          </details>
        ))
      }
    </div>
  </section>
  <Dots />
  <RegistroCta cta={page.cta} />
</BaseLayout>
