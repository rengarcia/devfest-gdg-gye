---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LogoTile from '../components/LogoTile.astro';
import RegistroCta from '../components/RegistroCta.astro';
import { getSiteSettings, getSponsorTiers } from '../sanity/content';

const [settings, tiers] = await Promise.all([getSiteSettings(), getSponsorTiers()]);
const paid = tiers.filter((t) => t.kind === 'paid');
const community = tiers.filter((t) => t.kind === 'community');
---

<BaseLayout
  title="Sponsors"
  description="Paquetes de patrocinio de DevFest Guayaquil 2026."
  family="blue"
>
  <PageHero
    eyebrow="Sponsors"
    title="Las empresas que hacen posible el evento"
    lead="DevFest es gratis para 500 asistentes porque las empresas de la región lo respaldan. Así se ve ese apoyo."
    glyphs={['plus-blue', 'dot-red', 'half-circle-yellow']}
  />

  {
    /* The top tier gets bigger tiles in a two-column grid, as in the design. */
    paid.map((tier, i) => (
      <section class="section" style="padding-block:var(--space-9)" data-family={tier.family}>
        <div
          class="wrap"
          style="display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:var(--space-8);align-items:start"
        >
          <div class="reveal" style="display:grid;gap:var(--space-4)">
            <>
              <span class="chip chip--tint" style="justify-self:start">
                {tier.name}
              </span>
              <h2 class="display display--md">{tier.headline}</h2>
              <ul style="margin:0;padding-left:20px;display:grid;gap:8px">
                {tier.perks.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </>
          </div>
          <div class:list={['grid', i === 0 ? 'grid--2' : 'grid--3']} data-stagger>
            {tier.sponsors.map((s) => (
              <LogoTile sponsor={s} big={i === 0} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  {
    community.map((tier) => (
      <section class="section section--tint" data-family={tier.family}>
        <div class="wrap">
          <div class="section__head reveal">
            <span class="chip chip--tint" style="justify-self:start">
              {tier.name}
            </span>
            <h2 class="display display--md">{tier.headline}</h2>
            {tier.description && <p class="lead">{tier.description}</p>}
          </div>
          <div class="grid grid--4" data-stagger>
            {tier.sponsors.map((s) => (
              <LogoTile sponsor={s} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <RegistroCta
    eyebrow="Patrocina"
    title="Pon tu marca frente a 500 developers"
    lead="Te enviamos el prospecto con precios y disponibilidad en menos de 48 horas."
    primary={{ label: 'Pedir el prospecto', href: '#' }}
    secondary={{ label: settings.sponsorsEmail, href: `mailto:${settings.sponsorsEmail}` }}
  />
</BaseLayout>
