---
import Icon from './Icon.astro';
import type { Cta } from '../sanity/content';

/** The ink card that closes every page. Pages pass their resolved register block (`page.cta`). */
interface Props {
  cta: Cta;
}
const { eyebrow, title, lead, primary, secondary } = Astro.props.cta;
---

<section class="section" id="registro">
  <div class="wrap">
    <div
      class="card card--ink reveal"
      style="display:grid;gap:var(--space-5);grid-template-columns:minmax(0,1fr) auto;align-items:center;padding:var(--space-8)"
    >
      <div>
        <p class="eyebrow" style="color:var(--gdg-off-white);opacity:.8">{eyebrow}</p><h2
          class="display display--md"
          style="margin-top:12px"
        >
          {title}
        </h2><p class="lead" style="margin-top:12px;opacity:.85">{lead}</p>
      </div>
      <div style="display:flex;gap:var(--space-2);flex-wrap:wrap">
        <a class="btn btn--fill" href={primary.href}
          >{primary.label} <Icon name="arrow_forward" class="btn__icon" /></a
        ><a class="btn btn--inverse" href={secondary.href}>{secondary.label}</a>
      </div>
    </div>
  </div>
</section>
