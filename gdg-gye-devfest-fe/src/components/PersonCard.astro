---
import type { Family } from '../data/site';

/** Notch card with a photo, or initials on a tinted square. Speakers get a track chip + talk; organizers get the GDG mark. */
interface Props {
  family: Family;
  initials: string;
  photo?: { src: string; alt: string };
  name: string;
  role: string;
  talk?: string;
  tag?: string;
  delay?: number;
}
const { family, initials, photo, name, role, talk, tag, delay = 0 } = Astro.props;
---

<article
  class="notch notch--tint person hover-lift reveal"
  data-family={family}
  style={`--d:${delay}ms`}
>
  {
    photo ? (
      <div class="notch__media">
        <img class="notch__img" src={photo.src} alt={photo.alt} loading="lazy" />
      </div>
    ) : (
      <div class="notch__media" aria-hidden="true">
        <span class="person__initials">{initials}</span>
      </div>
    )
  }
  {
    tag ? (
      <span class="chip notch__tag" style="font-size:var(--text-mono-xs)">
        {tag}
      </span>
    ) : (
      <img class="notch__tag" src="/assets/gdg-logo.png" alt="" style="width:56px" />
    )
  }
  <div class="person__body">
    {talk && <p class="person__talk">{talk}</p>}<p class="person__name">{name}</p><p
      class="person__role"
    >
      {role}
    </p>
  </div>
</article>
