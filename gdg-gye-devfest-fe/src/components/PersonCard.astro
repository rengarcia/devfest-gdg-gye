---
import type { Family } from '../data/site';
import type { ResponsiveImage } from '../sanity/image';

/** Notch card with a photo, or initials on a tinted square. Speakers get a track chip + talk; organizers get the GDG mark. */
interface Props {
  family: Family;
  initials: string;
  photo?: ResponsiveImage & { alt: string };
  name: string;
  role: string;
  talk?: string;
  tag?: string;
  delay?: number;
}
const { family, initials, photo, name, role, talk, tag, delay = 0 } = Astro.props;
---

<article
  class="notch notch--tint person hover-lift reveal"
  data-family={family}
  style={`--d:${delay}ms`}
>
  {
    photo ? (
      <div class="notch__media">
        <img
          class="notch__img"
          src={photo.src}
          srcset={photo.srcset}
          sizes="(max-width: 540px) 100vw, 340px"
          width={photo.width}
          height={photo.height}
          alt={photo.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      <div class="notch__media" aria-hidden="true">
        <span class="person__initials">{initials}</span>
      </div>
    )
  }
  {
    tag ? (
      <span class="chip notch__tag" style="font-size:var(--text-mono-xs)">
        {tag}
      </span>
    ) : (
      <img
        class="notch__tag"
        src="/assets/gdg-logo.png"
        alt=""
        style="width:56px"
        width="296"
        height="176"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="person__body">
    {talk && <p class="person__talk">{talk}</p>}<p class="person__name">{name}</p><p
      class="person__role"
    >
      {role}
    </p>
  </div>
</article>
