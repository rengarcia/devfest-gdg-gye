---
import Lockup from './Lockup.astro';
import Icon from './Icon.astro';
import { getSiteSettings } from '../sanity/content';

const settings = await getSiteSettings();
const registerLabel = settings.registerCta.primary.label;
// Straight to the account page once it exists; until then, to the register block of the page.
const registerHref = settings.registerHref === '#' ? '#registro' : settings.registerHref;
// site.ts swaps label and destination to the account when the visitor is signed in.
const accountCta = { 'data-account-label': settings.accountLabel, 'data-account-href': '/cuenta' };
const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <div class="wrap site-header__inner">
    <Lockup href="/" label="DevFest Guayaquil, inicio" class="site-header__lockup" />
    <nav class="nav" id="nav" aria-label="Principal">
      <ul class="nav__list">
        {
          settings.navigation.map((l) => (
            <li class="nav__item">
              <a
                class="nav__link"
                href={l.href}
                aria-current={normalize(l.href) === current ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul><div class="nav__extra">
        <a class="btn btn--fill nav__cta" href={registerHref} {...accountCta}
          ><span data-account-text>{registerLabel}</span>
          <Icon name="arrow_forward" class="btn__icon" /></a
        ><p class="nav__meta"><span>{settings.dateShort}</span><span>{settings.venue}</span></p>
      </div>
    </nav>
    <div class="site-header__actions">
      <a class="btn btn--fill site-header__cta" href={registerHref} {...accountCta}
        ><span data-account-text>{registerLabel}</span></a
      ><button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav"
        aria-label="Abrir menú"><Icon name="menu" class="site-header__toggle-icon" /></button
      >
    </div>
  </div>
</header>
