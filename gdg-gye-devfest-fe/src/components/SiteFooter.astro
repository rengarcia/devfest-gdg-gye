---
import Lockup from './Lockup.astro';
import { getSiteSettings } from '../sanity/content';

const settings = await getSiteSettings();
const { footer } = settings;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <div>
        <Lockup href="/" label="DevFest Guayaquil" /><p class="mono" style="margin-top:16px">
          {settings.dateLong}<br />{settings.venue}
        </p>
      </div>
      {
        footer.columns.map((column) => (
          <div>
            <h4 class="site-footer__heading">{column.heading}</h4>
            <ul class="site-footer__list">
              {column.links.map((l) => (
                <li>
                  <a class="site-footer__link" href={l.href}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div>
        <h4 class="site-footer__heading">{footer.followHeading}</h4><ul class="site-footer__list">
          <li>
            <a class="site-footer__link" href={settings.communityUrl}>{settings.communityLabel}</a>
          </li><li>
            <a class="site-footer__link" href={settings.socialHref}>{settings.handle}</a>
          </li><li>
            <a class="site-footer__link" href={`mailto:${settings.email}`}>{settings.email}</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <p class="mono mono--muted" style="font-size:var(--text-mono-sm)">{footer.tagline}</p><div
        class="site-footer__gdg"
      >
        <img class="site-footer__gdg-logo" src="/assets/gdg-logo.png" alt="" /><img
          class="site-footer__gdg-wordmark"
          src="/assets/gdg-wordmark.png"
          alt="Google Developer Groups"
        />
      </div>
    </div>
  </div>
</footer>
