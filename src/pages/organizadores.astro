---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PersonCard from '../components/PersonCard.astro';
import RegistroCta from '../components/RegistroCta.astro';
import { organizers } from '../data/organizers';

const voluntariado = [
  { n: '40', label: 'voluntarios' },
  { n: '4 h', label: 'por turno' },
  { n: '6', label: 'equipos' },
  { n: '1', label: 'briefing previo' },
];
---
<BaseLayout title="Organizadores" description="El equipo organizador de GDG Guayaquil." family="red">

<PageHero eyebrow="Organizadores" title="Las personas detrás de DevFest" lead="Ocho organizadores y unos 40 voluntarios el día del evento. Todos con trabajo de tiempo completo, todos sin cobrar." glyphs={['at', 'dot-red', 'braces']} />

<section class="section" style="padding-top:0"><div class="wrap"><div class="grid g4">{organizers.map((o, i) => <PersonCard family={o.family} initials={o.initials} name={o.name} role={o.role} delay={(i % 3) * 80} />)}</div></div></section>

<section class="section section-bg"><div class="wrap" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--space-8);align-items:center">
<div data-reveal style="display:grid;gap:var(--space-4)"><p class="eyebrow">Voluntariado</p><h2 class="lg">Únete al equipo del 5 de diciembre</h2><p class="lead">Acreditación, salas, speakers, redes. Turnos de 4 horas, camiseta, almuerzo y acceso a todas las charlas fuera de tu turno.</p><div style="display:flex;gap:var(--space-3);flex-wrap:wrap"><a class="btn btn-fill" href="#">Quiero ser voluntario</a><a class="btn" href="/faq">Preguntas frecuentes</a></div></div>
<div class="grid" data-stagger style="grid-template-columns:1fr 1fr">
{voluntariado.map((v) => <div class="card card-sm stat" data-reveal><b style="font-size:var(--text-display-md)">{v.n}</b><span>{v.label}</span></div>)}
</div></div></section>

<RegistroCta />
</BaseLayout>
