---
import type { Session } from '../data/agenda';

interface Props {
  session: Session;
}
const { session } = Astro.props;
---
{session.isBreak ? (
  <li class="session break"><time>{session.time}</time><div><p class="t">{session.title}</p></div><div></div></li>
) : (
  <li class="session"><time>{session.time}</time><div><p class="t">{session.title}</p>{session.who && <p class="who">{session.who}</p>}</div><div class="chips">{session.chips?.map((c) => <span class:list={['chip', c.cls]}>{c.label}</span>)}</div></li>
)}
