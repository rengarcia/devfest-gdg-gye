---
import type { Family } from '../data/event';

/** Notch card with initials on a tinted square. Speakers get a track chip + talk; organizers get the GDG mark. */
interface Props {
  family: Family;
  initials: string;
  name: string;
  role: string;
  talk?: string;
  tag?: string;
  delay?: number;
}
const { family, initials, name, role, talk, tag, delay = 0 } = Astro.props;
---
<article class="notch tint-media person hover-lift" data-family={family} data-reveal style={`--d:${delay}ms`}>
<div class="notch-media" aria-hidden="true"><span class="initials">{initials}</span></div>
{tag ? <span class="chip notch-tag" style="font-size:var(--text-mono-xs)">{tag}</span> : <img class="notch-tag" src="/assets/gdg-logo.png" alt="" style="width:56px" />}
<div class="person-body">{talk && <p class="talk">{talk}</p>}<p class="name">{name}</p><p class="role">{role}</p></div>
</article>
