---
/** The { DevFest } Guayaquil brand lockup used in the header, footer and load intro. */
interface Props {
  href?: string;
  label: string;
}
const { href = '/', label } = Astro.props;
---
<a class="lockup" href={href} aria-label={label}><img src="/assets/glyphs/brace-left.png" alt="" /><b>DevFest</b><img src="/assets/glyphs/brace-right.png" alt="" /><span class="loc">Guayaquil</span></a>
