---
/** The { DevFest } Guayaquil brand lockup used in the header, footer and load intro. */
interface Props {
  href?: string;
  label: string;
  /** Extra class (BEM mix) for the context the lockup sits in, e.g. `site-header__lockup`. */
  class?: string;
}
const { href = '/', label, class: mix } = Astro.props;
---

<a class:list={['lockup', mix]} href={href} aria-label={label}
  ><img class="lockup__brace" src="/assets/glyphs/brace-left.png" alt="" /><b class="lockup__name"
    >DevFest</b
  ><img class="lockup__brace" src="/assets/glyphs/brace-right.png" alt="" /><span
    class="lockup__city">Guayaquil</span
  ></a
>
