---
import Lockup from './Lockup.astro';
import { event } from '../data/event';
---
<footer class="site-footer"><div class="wrap">
<div class="site-footer__top">
<div><Lockup href="/" label="DevFest Guayaquil" /><p class="mono" style="margin-top:16px">{event.dateLong}<br />{event.venue}</p></div>
<div><h4 class="site-footer__heading">Evento</h4><ul class="site-footer__list"><li><a class="site-footer__link" href="/agenda">Agenda</a></li><li><a class="site-footer__link" href="/speakers">Speakers</a></li><li><a class="site-footer__link" href="/sponsors">Sponsors</a></li><li><a class="site-footer__link" href="/faq">FAQ</a></li></ul></div>
<div><h4 class="site-footer__heading">Comunidad</h4><ul class="site-footer__list"><li><a class="site-footer__link" href="/nosotros">Nosotros</a></li><li><a class="site-footer__link" href="/organizadores">Organizadores</a></li><li><a class="site-footer__link" href="/faq#conducta">Código de conducta</a></li></ul></div>
<div><h4 class="site-footer__heading">Síguenos</h4><ul class="site-footer__list"><li><a class="site-footer__link" href="#">{event.community}</a></li><li><a class="site-footer__link" href="#">{event.handle}</a></li><li><a class="site-footer__link" href="#">{event.email}</a></li></ul></div>
</div>
<div class="site-footer__bottom"><p class="mono mono--muted" style="font-size:var(--text-mono-sm)">Organizado por voluntarios de GDG Guayaquil. DevFest es una marca de Google.</p><div class="site-footer__gdg"><img class="site-footer__gdg-logo" src="/assets/gdg-logo.png" alt="" /><img class="site-footer__gdg-wordmark" src="/assets/gdg-wordmark.png" alt="Google Developer Groups" /></div></div>
</div></footer>
