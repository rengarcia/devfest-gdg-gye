---
/** Material Symbols Rounded glyph (decorative). `material-symbols-rounded` is the font's own class. */
interface Props {
  name: string;
  /** Extra class (BEM mix) for the context the icon sits in, e.g. `btn__icon`. */
  class?: string;
}
const { name, class: mix } = Astro.props;
---
<span class:list={['material-symbols-rounded', mix]} aria-hidden="true">{name}</span>
